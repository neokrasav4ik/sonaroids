# systemd unit for the leaderboard server. Install: sudo cp server/sonaroids-api.service /etc/systemd/system/ && sudo systemctl enable --now sonaroids-api
[Unit]
Description=Sonaroids leaderboard (api.sonaroids.app)
After=network.target

[Service]
User=sonaroids
Group=sonaroids
WorkingDirectory=/opt/sonaroids
Environment=PORT=8787
Environment=DB=/var/lib/sonaroids/sonaroids.db
Environment=ORIGINS=https://sonaroids.app,https://www.sonaroids.app
ExecStart=/usr/bin/node --no-warnings server/server.js
Restart=always
RestartSec=3
# keep it boxed in: read-only system, writable only its data folder
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/sonaroids

[Install]
WantedBy=multi-user.target
